index 0000000..2aa30c8
--- /dev/null
+++ b/internal/ciphersuite/ecdhe_ecdsa_aes128_cbc_sha256_test.go
@@ -0,0 +1,28 @@
+// SPDX-FileCopyrightText: 2026 The Pion community <https://pion.ly>
+// SPDX-License-Identifier: MIT
+
+package ciphersuite
+
+import (
+	"testing"
+
+	cryptosuite "github.com/pion/dtls/v4/pkg/crypto/ciphersuite"
+	"github.com/pion/dtls/v4/pkg/crypto/clientcertificate"
+)
+
+func TestECDHEECDSAAES128CBCSHA256(t *testing.T) {
+	const id cryptosuite.ID = 0xc023
+	s := ForID(id)
+	if s == nil {
+		t.Fatal("suite 0xc023 is not registered")
+	}
+	if s.ID() != id || s.String() != "TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256" {
+		t.Fatalf("unexpected suite %v", s)
+	}
+	if s.CertificateType() != clientcertificate.ECDSASign || s.AuthenticationType() != cryptosuite.AuthenticationTypeCertificate || s.KeyExchangeAlgorithm() != cryptosuite.KeyExchangeAlgorithmEcdhe || !s.ECC() {
+		t.Fatal("unexpected suite authentication or key exchange")
+	}
+	if s.HashFunc()().Size() != 32 {
+		t.Fatal("expected SHA-256")
+	}
+}
