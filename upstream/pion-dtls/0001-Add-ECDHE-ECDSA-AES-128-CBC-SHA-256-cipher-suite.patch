 	TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384       ID = 0xc02c // nolint: revive,staticcheck
 	TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384         ID = 0xc030 // nolint: revive,staticcheck
