# User unit (no sudo needed): ~/.config/systemd/user/lwm2m-demo.service,
# binary in ~/.local/lib/lwm2m-demo/. The home directory is hidden from the
# process (ProtectHome=tmpfs), only the binary directory is bound back.
# Needs `loginctl enable-linger $USER`.
[Unit]
Description=LwM2M public demo server (github.com/fiumaralabs/lwm2m)
After=network-online.target

[Service]
ExecStart=%h/.local/lib/lwm2m-demo/lwm2m-demo -coap :5683 -coaps :5684 -http 127.0.0.1:8090
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/lib/lwm2m-demo
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
TasksMax=512
RuntimeMaxSec=1d

[Install]
WantedBy=default.target
